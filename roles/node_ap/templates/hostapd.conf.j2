# {{ ansible_managed }}
interface={{ node_ap_iface }}
driver=nl80211
ctrl_interface=/var/run/hostapd
ctrl_interface_group=0

ssid={{ node_ap_ssid }}
country_code={{ node_ap_country }}
ieee80211d=1
hw_mode=g
channel={{ node_ap_channel }}
ieee80211n=1
wmm_enabled=1
auth_algs=1
ignore_broadcast_ssid=0

# WPA2-PSK with CCMP only: what every node and phone supports. No PMF
# (802.11w): the Pi 3's brcmfmac can't do it as an AP.
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
ieee80211w=0
wpa_passphrase={{ node_ap_psk }}
