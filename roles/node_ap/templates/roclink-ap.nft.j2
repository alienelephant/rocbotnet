#!/usr/sbin/nft -f
# {{ ansible_managed }}
# The roclink node network ({{ node_ap_iface }}): nodes may get an address
# (DHCP), ping the Pi, and send roclink frames to
# roclink-gw on UDP {{ roclink_udp_port }}. Nothing else: no SSH or MQTT from
# nodes, and no forwarding to the LAN or the internet.
#
# Only this table is touched, so other nftables rules stay as they are; a
# drop here wins over an accept elsewhere.
table inet roclink_ap
delete table inet roclink_ap

table inet roclink_ap {
    chain input {
        type filter hook input priority filter - 10; policy accept;
        iifname "{{ node_ap_iface }}" jump from_nodes
    }

    chain from_nodes {
        ct state established,related accept
        udp dport 67 accept comment "DHCP"
        icmp type echo-request accept
        udp dport {{ roclink_udp_port }} accept comment "roclink-gw"
        counter drop
    }

    chain forward {
        type filter hook forward priority filter - 10; policy accept;
        iifname "{{ node_ap_iface }}" counter drop comment "nodes reach the Pi only"
        oifname "{{ node_ap_iface }}" counter drop
    }
}
