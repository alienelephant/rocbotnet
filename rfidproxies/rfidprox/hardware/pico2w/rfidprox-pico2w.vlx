        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"RDM6300\",\n  \"author\": \"velxio-bom\",\n  \"license\": \"MIT\",\n  \"description\": \"RDM6300 125 kHz EM4100 reader module (layout only, no simulation). P1: TX RX NC GND +5V; P3: LED +5V GND; P2: antenna coil.\",\n  \"pins\": [\n    { \"name\": \"TX\",    \"x\": 8,   \"y\": 14 },\n    { \"name\": \"RX\",    \"x\": 8,   \"y\": 34 },\n    { \"name\": \"NC\",    \"x\": 8,   \"y\": 54 },\n    { \"name\": \"GND\",   \"x\": 8,   \"y\": 74 },\n    { \"name\": \"+5V\",   \"x\": 8,   \"y\": 94 },\n    { \"name\": \"LED\",   \"x\": 192, \"y\": 14 },\n    { \"name\": \"+5V.2\", \"x\": 192, \"y\": 34 },\n    { \"name\": \"GND.2\", \"x\": 192, \"y\": 54 },\n    { \"name\": \"ANT1\",  \"x\": 192, \"y\": 74 },\n    { \"name\": \"ANT2\",  \"x\": 192, \"y\": 94 }\n  ],\n  \"attributes\": []\n}\n",
        "sourceC": "// RDM6300: a layout-only part (velxio-bom). It matches the module's pinout so\n// it can be wired on the canvas; it simulates nothing.\n#include \"velxio-chip.h\"\n\nvoid chip_setup(void) {\n}\n",
