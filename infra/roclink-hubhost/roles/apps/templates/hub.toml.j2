# {{ ansible_managed }}
# roclink-hub on the hub host (config.example.toml in hub/roclink-hub says what
# each setting does). Paths are inside the container: /var/lib/roclink-hub is
# {{ roclink_root }}/data/hub.
log_level = "INFO"

[database]
path = "/var/lib/roclink-hub/hub.db"

[mqtt]
host = "127.0.0.1"
port = {{ mqtt_port }}
client_id = "roclink-hub"
username = "roclink-hub"
password = "{{ mqtt_users['roclink-hub'] }}"

# No auth: on 127.0.0.1, and behind a client certificate at :{{ hubapi_https_port }}.
[api]
host = "127.0.0.1"
port = {{ hub_api_port }}

[public]
nets = [0xF0]
db_path = "/var/lib/roclink-hub/public.db"

# The public page's API: at http://<hub>/public/ through Caddy.
[public.api]
enabled = true
host = "127.0.0.1"
port = {{ public_api_port }}

# The box's own data on schema 32: BoxLink's example sketch (boxlink/examples/sensor_box).
[decoder.box-reading]
struct = "<hfB"
fields = ["temp_c", "humidity", "flags"]
scale = { temp_c = 0.01 }
bits = { flags = ["door_open", "lid_closed"] }

# The game's boxes: simulated ones (tools/scavbox.py) at 0x0200-0x02FF, and the
# Heltec breadboard (rfidprox, game-box build) at 0x0301.
[[device_type]]
name = "scavhunt-box"
class = "always_listening"
schemas = { 32 = "box-reading" }   # the box's own data (BOXLINK.md 9); 1-5 are the game's

[[node]]
net = 0x42
nodes = ["0x0200-0x02FF"]
type = "scavhunt-box"

# The scavbox examples: a box behind a proxy, the XIAO over Wi-Fi at 0x0302
# (roclink-scavbox-wifi), the Heltec over LoRa at 0x0301 (roclink-scavbox-lora),
# the XIAO that logs in by itself at 0x0303 (roclink-scavbox-picow), and the
# Pico 2 W fob proxy at 0x0304 (rfidprox pico2w_fobproxy: a tapped fob logs in). One
# address per proxy board (rfidprox docs/BOXLINK.md 9). Their schema 32 is
# their own: press count and hold time.
[decoder.scavbox-press]
struct = "<HH"
fields = ["presses", "held_ms"]

[[device_type]]
name = "scavbox"
class = "always_listening"
schemas = { 32 = "scavbox-press" }

[[node]]
net = 0x42
nodes = ["0x0301", "0x0302", "0x0303", "0x0304"]
type = "scavbox"

[[route]]
service = "scavhunt"
net = 0x42
types = ["scavhunt-box", "scavbox"]
schemas = [1, 2, 3, 4, 5, 10, 11]  # the game's messages, both ways (a route also limits downlink)

[schemas]
1 = "text"
